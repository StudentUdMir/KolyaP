body {
    font-family: sans-serif;
    background: black;
    ;
}


header {
    background-color: rgb(255, 255, 255);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background-image: url(https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT1AFnFH7Ne8KgeuX2LHzZvTBkbV6lHfxzR7w&s)
}

header img{
    height: 160px;
    width: 160px;
    border-radius: 100px;
}


nav {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    vertical-align: middle;
    text-align: center;
    height: 75px;
    border-color: #EF930A;
}


nav a {
    text-decoration: none;
    font-size: 50px;
    background-color: #EF930A;
    color: black;
    border: 1px solid #000000;
    border-radius: 15px;
    padding: 10px;
    margin: 10px;
    height: 50px;
    width:275px ;    
}
    nav a:hover{
        background-color: #ffd900;
    }
h1 {
    background-color: #F7D975;
    color: #C78300;
    text-align: center;
    font-size: 40px;
    padding: 10px;
    border-radius: 15px;
}


main {
    margin: 50px;;
}


main img {
    width: 300px
}


.gallery {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
}




footer {
    border-radius: 15px;
    background-color: #ECDB9E;
    padding: 10px;
    font-size: 20px;
}

footer img {
    border-radius: 15px;
}

p {
    color: orange;

}
main img {
    border-radius: 40px;
    width: 180px;
    height: 180px;
}
